# Frontend env for local `next dev` (HRP-854).
#
# next.config.ts does NOT read the repository root .env: Next.js only loads
# the .env* files that live in this directory. Copy this file to .env.local
# (gitignored) and uncomment what you need. In Docker/SaaS these values
# arrive as build args or at runtime via window.__ENV__ instead.

# Where the browser talks to the backend. The default "/api" is a relative
# path and works when the frontend is proxied next to the API; for a local
# backend on its own port set the full origin.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# onprem hides self-serve workspace registration (register page).
# DEPLOYMENT_MODE=onprem

# Public process check (HRP-918): the host the check pages answer on and
# the app's own domain, used by server-side host routing.
# PUBLIC_CHECK_ENABLED=true
# PUBLIC_CHECK_HOST=check.localhost
# NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# Marketing site the app links back to (landing, pricing).
# NEXT_PUBLIC_MARKETING_DOMAIN=hrpulsar.com

# Extra origins allowed for images/files in the CSP of proxied pages.
# NEXT_PUBLIC_FILES_ORIGIN=

# Cloudflare Turnstile widget of the public check form.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# UI locales offered and the fallback (en is always the hard fallback).
# NEXT_PUBLIC_AVAILABLE_LOCALES=en,de
# NEXT_PUBLIC_DEFAULT_LOCALE=en

# Money formatting of billing screens (BCP 47 locale).
# NEXT_PUBLIC_BILLING_CURRENCY=USD
# NEXT_PUBLIC_BILLING_LOCALE=en-US

# White-label branding (defaults are the HRPulsar brand).
# NEXT_PUBLIC_BRAND_NAME=Acme Talent
# NEXT_PUBLIC_LOGO_URL=https://cdn.acme.example/logo-light-bg.svg
# NEXT_PUBLIC_LOGO_DARK_URL=https://cdn.acme.example/logo-dark-bg.svg
# NEXT_PUBLIC_BRAND_ACCENT_COLOR=#0066FF
# NEXT_PUBLIC_FAVICON_URL=https://cdn.acme.example/favicon.png
# NEXT_PUBLIC_SIDEBAR_LOGO_HEIGHT=28px
# NEXT_PUBLIC_BRAND_THEME=default
# NEXT_PUBLIC_BRAND_AUTH_BG_COLOR=#060a14
# NEXT_PUBLIC_BRAND_AUTH_BG_URL=https://cdn.acme.example/auth-bg.jpg

# Demo tenant extras.
# NEXT_PUBLIC_DEMO_FEEDBACK_DELAY_MS=120000
# NEXT_PUBLIC_DEMO_CONTACT_PHONE=
# NEXT_PUBLIC_GOOGLE_ADS_DEMO_CONVERSION=

# Sentry: a DSN turns the SDK on; the auth token makes the build upload
# source maps (CI only).
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_AUTH_TOKEN=
