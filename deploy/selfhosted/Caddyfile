# HRPulsar self-hosted reverse proxy.
#
# HTTPS: replace ":80" with your domain (e.g. app.yourcompany.com) and
# restart caddy — a Let's Encrypt certificate is obtained automatically.
:80 {
	encode gzip

	@backend path /api/* /health
	handle @backend {
		# Cap the body at the edge: an unbounded POST is read into a
		# uvicorn worker until the box runs out of memory. 110MB clears
		# the largest legitimate request (a 100MB bulk-resume batch,
		# RECRUITMENT_MAX_BULK_TOTAL_MB) plus multipart overhead.
		request_body {
			max_size 110MB
		}
		# Caddy adds X-Forwarded-For here by default; the backend honours
		# it only from a trusted peer, so per-IP rate limits see the real
		# client (see TRUSTED_PROXIES in .env.example).
		reverse_proxy backend:8000
	}

	# Browser-facing presigned file URLs (S3_PUBLIC_ENDPOINT in .env).
	# The path prefix is the bucket name — keep in sync with S3_BUCKET.
	# The Host header must reach MinIO unchanged (Caddy's default): SigV4
	# signatures are bound to the host the backend signed the URL for.
	@storage path /hrpulsar/*
	handle @storage {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
