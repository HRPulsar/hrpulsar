# === Required ===
DATABASE_URL=postgresql+asyncpg://hrpulsar:hrpulsar@localhost:5435/hrpulsar
REDIS_URL=redis://localhost:6381
JWT_SECRET=change-me-to-a-random-string
POSTGRES_PASSWORD=hrpulsar
# Public URL of your instance — used to build links in outgoing emails and
# in the backend-log verification fallback. Set it on any deployed install.
# FRONTEND_URL=https://hr.yourcompany.com

# === AI (optional, for competency generation and semantic search) ===
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# LLM_PROVIDER=claude               # claude, openai, gemini

# === Email (required for sign-up verification links; without a provider,
# outgoing emails are skipped and logged as warnings) ===
# Option A: Resend (recommended for SaaS)
# RESEND_API_KEY=re_...
# Option B: SMTP (self-hosted)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=HRPulsar <notifications@hrpulsar.com>

# === Waitlist (optional) ===
# Mirror landing-page waitlist signups into a Resend audience for bulk invites.
# Get the UUID from https://resend.com/audiences (in the URL as ?segmentId=<uuid>)
# or via `curl https://api.resend.com/audiences -H "Authorization: Bearer $RESEND_API_KEY"`.
# RESEND_WAITLIST_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# === File Storage (optional, metadata-only without S3) ===
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=hrpulsar
# Public base URL for presigned file links when S3_ENDPOINT is internal-only
# (docker-compose MinIO). Set to your site origin — the bundled Caddyfile
# proxies /<S3_BUCKET>/* to MinIO. Leave unset for public endpoints (e.g. R2).
# S3_PUBLIC_ENDPOINT=https://hr.yourcompany.com

# === Branding (optional, white-label) — see docs "Self-hosted → Branding" ===
# Backend (emails, API title):
# BRAND_NAME=Acme Talent
# BRAND_LOGO_URL=https://cdn.acme.example/email-logo.png
# BRAND_ACCENT_COLOR=#0066FF
# Frontend (web UI), read at runtime:
# NEXT_PUBLIC_BRAND_NAME=Acme Talent
# NEXT_PUBLIC_LOGO_URL=https://cdn.acme.example/logo-light-bg.svg
# NEXT_PUBLIC_LOGO_DARK_URL=https://cdn.acme.example/logo-dark-bg.svg
# NEXT_PUBLIC_BRAND_ACCENT_COLOR=#0066FF
# NEXT_PUBLIC_FAVICON_URL=https://cdn.acme.example/favicon.png

# === Deployment ===
# EDITION=community                  # community, enterprise
# DEPLOYMENT_MODE=onprem             # onprem (default), saas — enables enterprise routes & billing
# CORS_ORIGINS=http://localhost:3100 # comma-separated origins for production
# DEBUG=false

# === Sentry (optional, error tracking) ===
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1

# === Monitoring (optional, Promtail → Loki) ===
# LOKI_HOST=10.0.0.2                  # IP/domain of Loki server
# LOKI_USER=promtail                  # basic auth user
# LOKI_PASSWORD=                      # basic auth password

# === Server (for Docker) ===
# UVICORN_WORKERS=2
# CELERY_CONCURRENCY=2
# LOG_LEVEL=info
