# === Required ===
DATABASE_URL=postgresql+asyncpg://hrpulsar:hrpulsar@localhost:5435/hrpulsar
REDIS_URL=redis://localhost:6381
# Signs every access/refresh token, and seeds ENCRYPTION_KEY below when
# that one is left unset. Generate one with `openssl rand -hex 32`. The
# backend refuses to start when it is empty or still the old placeholder.
JWT_SECRET=
# AES-GCM key encrypting per-workspace AI provider keys (BYOK) at rest.
# urlsafe-base64, decoding to at least 32 bytes: `openssl rand -base64 32`.
# Unset on an on-premise install, the key is derived from JWT_SECRET —
# which means rotating JWT_SECRET without pinning ENCRYPTION_KEY first
# makes every stored BYOK key unreadable. DEPLOYMENT_MODE=saas requires
# it explicitly and refuses to start without it.
# ENCRYPTION_KEY=
POSTGRES_PASSWORD=hrpulsar
# Public URL of your instance — used to build links in outgoing emails and
# in the backend-log verification fallback. Set it on any deployed install.
# FRONTEND_URL=https://hr.yourcompany.com

# === Sessions & tokens (optional, defaults shown) ===
# JWT_ALGORITHM=HS256                # signing algorithm for access/refresh tokens
# ACCESS_TOKEN_EXPIRE_MINUTES=30     # lifetime of an access token
# REFRESH_TOKEN_EXPIRE_DAYS=7        # lifetime of a refresh token
# MAGIC_LOGIN_TOKEN_TTL_HOURS=24     # lifetime of a one-time login link
# SIGNUP_VERIFY_TOKEN_TTL_HOURS=24   # lifetime of a sign-up verification link

# === Rate limits (optional, defaults shown) ===
# Unauthenticated auth surface, per source IP (slowapi window syntax).
# AUTH_RATE_LIMIT_LOGIN=10/minute    # login, tenant select, invite preview/accept, verify-email
# AUTH_RATE_LIMIT_REGISTER=5/minute  # self-service registration
# AUTH_RATE_LIMIT_EMAIL=3/minute     # forgot/reset password, resend verification, magic link
# AUTH_RATE_LIMIT_REFRESH=30/minute  # token refresh
# SIGNUP_RATE_LIMIT_PER_IP_PER_HOUR=5        # landing sign-up requests per IP; 0 disables
# FEEDBACK_RATE_LIMIT_PER_USER_PER_HOUR=5    # in-product feedback per user; 0 disables
# INVITE_RESEND_COOLDOWN_SECONDS=300         # per invitation, before it can be resent
# INVITE_MAIL_CAP_PER_RECIPIENT_PER_HOUR=20  # invitation emails per address; 0 disables
# PUBLIC_API_RATE_LIMIT=60/minute            # /api/v1 integration API, per API key
# PUBLIC_API_BATCH_MAX_ITEMS=100             # items in one /api/v1 batch call

# === Upload ceilings (optional, megabytes, defaults shown) ===
# MAX_UPLOAD_MB=10                   # generic uploads (POST /files/upload, avatars)
# RECRUITMENT_MAX_RESUME_MB=10       # one candidate resume
# RECRUITMENT_MAX_ATTACHMENT_MB=25   # one vacancy/candidate attachment
# RECRUITMENT_MAX_BULK_TOTAL_MB=100  # total body of one bulk resume upload

# === AI (optional, for competency generation and semantic search) ===
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# YANDEX_API_KEY=...                # Yandex Foundation Models (OpenAI-compatible API)
# YANDEX_FOLDER_ID=...              # Yandex Cloud folder id, completes short model names
# LLM_PROVIDER=claude               # claude, openai, gemini, yandex
# Cloud deployments only: hostnames exempt from the SSRF guard on
# tenant-supplied AI endpoint URLs (comma-separated, operator-managed)
# AI_BASE_URL_ALLOWED_HOSTS=
# Per-item delay of the synthetic indicator progress stream, seconds.
# 0 disables the animation for matrices producing thousands of indicators.
# AI_PROGRESS_STEP_DELAY_S=0.04

# === Interview transcription (optional, recruiting module) ===
# Every key set here joins one fallback chain, tried in the order below, so
# a refused or deactivated credential costs a provider, not the interview.
# AssemblyAI and SpeechKit separate the speakers themselves; where the
# provider that answered did not, the turns are split into interviewer and
# candidate by an LLM pass over the transcript.
# ASSEMBLYAI_API_KEY=...
# DEEPGRAM_API_KEY=...
# Yandex SpeechKit: keeps the audio inside Russia, and needs
# YANDEX_FOLDER_ID above as well. Falls back to YANDEX_API_KEY when unset —
# the same service account then needs the ai.speechkit-stt.user role.
# YANDEX_SPEECHKIT_API_KEY=...
# Whisper rides on OPENAI_API_KEY above and is tried last.
# Provider used when a workspace has configured none of its own
# TRANSCRIPTION_PROVIDER_DEFAULT=whisper

# === Email (required for sign-up verification links; without a provider,
# outgoing emails are skipped and logged as warnings) ===
# Option A: Resend (recommended for SaaS)
# RESEND_API_KEY=re_...
# Signing secret of the Resend delivery webhook; unset → /api/webhooks/email refuses every call.
# RESEND_WEBHOOK_SECRET=whsec_...
# Option B: SMTP (self-hosted)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# From header of outgoing email. Branded installs (BRAND_NAME) must set
# this — the default keeps the stock sender identity.
# EMAIL_FROM=HRPulsar <notifications@hrpulsar.com>

# === Waitlist (optional) ===
# Mirror landing-page waitlist signups into a Resend audience for bulk invites.
# Get the UUID from https://resend.com/audiences (in the URL as ?segmentId=<uuid>)
# or via `curl https://api.resend.com/audiences -H "Authorization: Bearer $RESEND_API_KEY"`.
# RESEND_WAITLIST_AUDIENCE_ID=00000000-0000-0000-0000-000000000000
# Audience mirroring sign-up requests (cloud sign-up funnel).
# RESEND_SIGNUP_AUDIENCE_ID=00000000-0000-0000-0000-000000000000
# Cloudflare Turnstile secret for the sign-up form; empty disables the bot guard.
# SIGNUP_TURNSTILE_SECRET=

# === File Storage (optional, metadata-only without S3) ===
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=hrpulsar
# Public base URL for presigned file links, used when S3_ENDPOINT is an
# internal-only hostname (docker-compose MinIO): browsers can't reach
# minio:9000, so links must be signed against a reachable origin. Defaults
# to FRONTEND_URL — the bundled Caddyfile proxies /<S3_BUCKET>/* to MinIO
# from there. Set it explicitly only when storage lives on another origin;
# with neither value the backend refuses to start. Leave unset for public
# endpoints (e.g. R2).
# S3_PUBLIC_ENDPOINT=https://hr.yourcompany.com

# === Branding (optional, white-label) — see docs "Self-hosted → Branding" ===
# Backend (emails, API title):
# BRAND_NAME=Acme Talent
# BRAND_LOGO_URL=https://cdn.acme.example/email-logo.png
# BRAND_ACCENT_COLOR=#0066FF
# Frontend (web UI), read at runtime:
# NEXT_PUBLIC_BRAND_NAME=Acme Talent
# NEXT_PUBLIC_LOGO_URL=https://cdn.acme.example/logo-light-bg.svg
# NEXT_PUBLIC_LOGO_DARK_URL=https://cdn.acme.example/logo-dark-bg.svg
# NEXT_PUBLIC_BRAND_ACCENT_COLOR=#0066FF
# NEXT_PUBLIC_FAVICON_URL=https://cdn.acme.example/favicon.png
# NEXT_PUBLIC_SIDEBAR_LOGO_HEIGHT=28px   # sidebar logo height override (px/rem)
# NEXT_PUBLIC_BRAND_THEME=default        # theme preset: default, teal, slate, violet
# NEXT_PUBLIC_BRAND_AUTH_BG_COLOR=#060a14          # login/register background color
# NEXT_PUBLIC_BRAND_AUTH_BG_URL=https://cdn.acme.example/auth-bg.jpg  # login/register background image

# === Interface locales (optional, i18n) ===
# Backend (error messages, emails):
# AVAILABLE_LOCALES=en               # comma-separated UI locales offered, e.g. "de,en"
# DEFAULT_LOCALE=en                  # fallback locale; must be listed in AVAILABLE_LOCALES
# Frontend (web UI), read at runtime — keep in sync with the backend pair:
# NEXT_PUBLIC_AVAILABLE_LOCALES=en
# NEXT_PUBLIC_DEFAULT_LOCALE=en

# === Currency (optional) ===
# Installation currency. Defaults the salary ranges on specialization
# grades and employee compensations; also the billing money layer in
# enterprise builds. Keep the pair in sync — the backend writes the
# defaults, the frontend prefills the forms.
# BILLING_CURRENCY=USD               # ISO 4217 code, e.g. EUR, RUB
# NEXT_PUBLIC_BILLING_CURRENCY=USD
# NEXT_PUBLIC_BILLING_LOCALE=en-US   # BCP 47 locale used to format money
# BILLING_LOCALE=en-US               # backend-side money formatting (invoices, emails)
# Cloud builds only — self-hosted has no billing layer:
# BILLING_PAYMENT_PROVIDER=manual_invoice  # manual_invoice, stripe, yookassa, none
# BILLING_PROFILE_PATH=              # per-site pricing profile; empty = stock profile

# === Deployment ===
# EDITION=community                  # community, enterprise
# DEPLOYMENT_MODE=onprem             # onprem (default), saas — enables enterprise routes & billing
# CORS_ORIGINS=http://localhost:3100 # comma-separated origins for production
# Comma-separated CIDRs / IPs of the reverse proxies in front of the app.
# X-Forwarded-For is honoured only from these peers, and the per-IP rate
# limits (login, forgot-password, sign-up, demo) then key on the client
# address it carries. Unset falls back to the private ranges, which is
# what the bundled Caddy needs. Set it when the app is reached through a
# proxy on a PUBLIC address (Cloudflare, an external load balancer) and
# list that proxy's ranges — otherwise every request keys on the proxy's
# own IP and one user hitting a limit throttles the whole company.
# TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22
# DEBUG=false
# Exposes the dev/E2E-only auth routes. Never true on a deployed install.
# E2E_MODE=false

# === Demo sandbox (optional, public evaluation tenants) ===
# DEMO_ENABLED=false                 # master switch; false → POST /api/demo/start is 503
# DEMO_SESSION_TTL_SECONDS=14400     # hard lifetime of a demo tenant (4 h)
# DEMO_INACTIVITY_TTL_SECONDS=14400  # sliding inactivity timeout
# DEMO_ACTIVITY_TOUCH_DEBOUNCE_SECONDS=60  # debounce for the last-activity write
# DEMO_MAX_CONCURRENT_SESSIONS=50    # hard cap on live demo tenants
# DEMO_INITIAL_CREDITS=250           # AI budget granted to a fresh demo tenant
# DEMO_RATE_LIMIT_PER_IP_PER_HOUR=5  # session creation per IP; 0 disables
# DEMO_QUOTA_UPLOADS=2               # uploads per demo session; 0 disables
# DEMO_MAX_UPLOAD_MB=5               # size of one demo upload
# DEMO_AI_KILLSWITCH=false           # true → demo AI tasks use fixtures, not providers
# DEMO_TURNSTILE_SECRET=             # bot guard for /api/demo/start; empty disables
# DEMO_COOKIE_SECURE=true            # keep true on any HTTPS deploy
# DEMO_COOKIE_SAMESITE=lax           # lax, strict, none (none for split SPA/API hosts)
# DEMO_COOKIE_DOMAIN=                # empty = host-scoped to the API host
# Legacy fallback for TRUSTED_PROXIES above; set that one instead.
# DEMO_TRUSTED_PROXIES=

# === Sentry (optional, error tracking) ===
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1

# === Monitoring (optional, Promtail → Loki) ===
# LOKI_HOST=10.0.0.2                  # IP/domain of Loki server
# LOKI_USER=promtail                  # basic auth user
# LOKI_PASSWORD=                      # basic auth password

# === Server (for Docker) ===
# UVICORN_WORKERS=2
# CELERY_CONCURRENCY=2
# LOG_LEVEL=info
